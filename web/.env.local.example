# Copy to web/.env.local and fill in. .env.local is gitignored; this repo is public.

# --- Anthropic ---
# The key the ingest route uses to call Claude.
ANTHROPIC_API_KEY=

# --- Firebase Admin (server) ---
# Absolute path to the service account JSON. Never commit the file itself.
# Locally: /Users/<you>/.config/knight-life/bbn-daily-admin.json
GOOGLE_APPLICATION_CREDENTIALS=
# On a host with no filesystem for secrets (Vercel), set this instead: the whole
# service account JSON as one line. Set one of the two, not both.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Firebase Web (client, NEXT_PUBLIC_*) ---
# From Firebase console > Project settings > Your apps > Web app.
# These are not secrets; access is controlled by Firestore rules and the admins collection.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Demo route ---
# /demo and /api/demo/* are a sandbox that never touches Firestore. The route
# still calls Claude, so it is off unless this is exactly "true".
DEMO_ENABLED=false
