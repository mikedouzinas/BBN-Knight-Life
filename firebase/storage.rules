rules_version = '2';

// Knight Life Storage rules. Holds special-schedule images and lunch menu images
// (6 objects total). Students read them; only admins upload.
//
// Admins come from the `admins` collection in Firestore, so the maintainer list lives in
// exactly one place and these two rule files cannot drift apart.

service firebase.storage {
  match /b/{bucket}/o {

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(email()));
    }

    match /schedules/{file}   { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /lunchmenus/{file}  { allow read: if request.auth != null; allow write: if isAdmin(); }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
