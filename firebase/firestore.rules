rules_version = '2';

// Knight Life Firestore rules.
//
// Before HQ-601, the entire database was `allow read, write: if request.auth != null`,
// meaning any of ~645 signed-in accounts could rewrite the school schedule or read every
// student record. These rules keep every access pattern the shipped 2.4.1 app relies on
// and close everything else.
//
// Admins are documents in the `admins` collection, keyed by lowercase email. Adding a
// maintainer is a Firestore write, not a code change and a deploy, because handing this
// project to the next student is the path that most needs to stay easy. It also keeps
// student email addresses out of a public repository.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return hasEmail()
        && exists(/databases/$(database)/documents/admins/$(email()));
    }

    // Fields on a student's own record that the student must never write, because a server
    // reads them back as a limit. See the `users` rule and `student-budgets` below.
    function serverOwnedUserFields() {
      return ['classSetupSubmissionsRemaining', 'classSetupBudgetResetsAt'];
    }

    // Who can publish schedules.
    //
    //   get   - your own row, or any row if you are an admin. The app reads its own row on
    //           launch to decide whether to show the schedule editor. Learning your own
    //           status leaks nothing you did not already know.
    //   list  - admins only, so the maintainer list is not a directory students can pull.
    //   write - never from a client. Changed through the console or the Admin SDK.
    match /admins/{adminEmail} {
      allow get:   if isAdmin() || (hasEmail() && adminEmail == email());
      allow list:  if isAdmin();
      allow write: if false;
    }

    // Schedule data. Every student reads it; only admins change it.
    match /schedules/{doc}         { allow read: if signedIn(); allow write: if isAdmin(); }
    match /special-schedules/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /default-schedules/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /ifstatements/{doc}      { allow read: if signedIn(); allow write: if isAdmin(); }

    // Who published which schedule, written by the admin tool in web/ through the
    // Admin SDK (which bypasses these rules). Nothing in the app reads it, so it stays
    // closed to clients; `write: if false` means it can only ever be written by a
    // server holding the service account, which is what makes it evidence.
    match /schedule-publish-log/{day} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Student records.
    //   get   - allowed, because ClassPopupVC shows who else is in your class.
    //   list  - admins only. Nothing in the app lists this collection
    //           (getTotalKnightLifeUsers is dead code), so denying it costs nothing
    //           and stops one query from returning every student's locker number.
    //   write - your own document, or the A-G block fields of a classmate's document,
    //           which is what DaySelectVC does when a class is renamed.
    //
    // The one thing a student may NOT write on their own record is a field the server reads
    // back as a limit. HQ-656 put a schedule-scan counter here, on the document its own
    // subject is allowed to write, so the student being rate-limited could raise their own
    // limit and spend the project's Anthropic budget without bound. The counter has since
    // moved to `student-budgets` below; this exclusion stays as the standing rule that a
    // server-authoritative value never lives on a client-writable document.
    match /users/{uid} {
      allow get:  if signedIn();
      allow list: if isAdmin();

      allow delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(serverOwnedUserFields()))
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['A', 'B', 'C', 'D', 'E', 'F', 'G'])
      );
    }

    // How many schedule scans a student has left this year (HQ-656). Server-authoritative:
    // written only by the Admin SDK, which bypasses these rules, and never readable or
    // writable by the student it governs. A limit stored anywhere its subject can reach is
    // not a limit, and `users/{uid}` is exactly such a place.
    match /student-budgets/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // The side menu's publication list (HQ-661), so adding a paper back or hiding one that
    // went quiet is a Firestore edit rather than a code change and an App Store release.
    // Every student reads it on launch; only a maintainer changes it.
    //
    // Without this rule the catch-all below denies the read, and the app's fallback to its
    // hardcoded list makes that denial look like nothing happened at all: the menu renders
    // correctly and the feature is inert. That is the failure this rule exists to prevent,
    // and `rules.emulator.test.ts` is what keeps it from coming back.
    match /sideMenu/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Class rosters. Students create and join classes, and ClassesOptionsPopupVC
    // queries this collection by block, so both get and list stay open.
    match /classes/{doc} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
